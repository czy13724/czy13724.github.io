---
import { getEntry, render } from "astro:content";
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";

import MainGridLayout from "../../layouts/MainGridLayout.astro";

const privacyPost = await getEntry("spec", "privacy-en");

if (!privacyPost) {
	throw new Error(`Privacy policy page content not found for slug: privacy-en`);
}

const { Content } = await render(privacyPost);
const title = "Privacy Policy";
---

<MainGridLayout title={title}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<PageHeader title={title} />

			<div class="flex justify-end mt-2 mb-4">
				<a href="/privacy/" class="text-sm text-[var(--primary)] hover:underline flex items-center gap-1 transition-colors">
					<span class="iconify" data-icon="material-symbols:translate"></span>
					阅读中文版
				</a>
			</div>

			<!-- 从MD文件读取的内容 -->
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
