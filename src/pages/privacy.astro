---
import { getEntry, render } from "astro:content";
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";

import MainGridLayout from "../layouts/MainGridLayout.astro";

const privacyPost = await getEntry("spec", "privacy");

if (!privacyPost) {
	throw new Error("Privacy policy page content not found");
}

const { Content } = await render(privacyPost);
const title = "Privacy Policy";
---

<MainGridLayout title={title}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<PageHeader title={title} />

			<!-- 从MD文件读取的内容 -->
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
